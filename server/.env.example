# Puerto del backend "portero"
PORT=8080

# Firma de los tokens de sesión (JWT). Genera uno largo y aleatorio en producción,
# p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Clave de la API de Gemini (SOLO aquí, nunca en la app). Si se deja vacía, el
# servidor usa un proveedor de IA "mock" determinista para poder probar todo el
# flujo Premium sin gastar ni un céntimo ni necesitar la clave todavía.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# CORS: origen(es) permitido(s) para llamadas desde la app (Expo). "*" en desarrollo.
CORS_ORIGIN=*

# RevenueCat: verificación real de suscripciones (App Store Connect / Google Play).
# Clave SECRETA del proyecto en RevenueCat (dashboard → Project settings → API keys
# → "Secret API key"). Se usa para consultar el estado real de un suscriptor desde
# el servidor. Si se deja vacía, /subscription/verify devuelve error en vez de
# activar un plan sin comprobar nada.
REVENUECAT_SECRET_API_KEY=

# Valor que configuras en RevenueCat (Integrations → Webhooks → Authorization
# header) para que el servidor pueda comprobar que un webhook viene de verdad de
# RevenueCat y no de cualquiera que adivine la URL.
REVENUECAT_WEBHOOK_SECRET=
