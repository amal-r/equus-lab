# URL del backend "portero" (server/). Déjala vacía para trabajar 100% en local:
# el plan gratis analiza on-device y las funciones Premium caen a una simulación
# local en vez de fallar (ver src/services/config.ts).
EXPO_PUBLIC_API_URL=http://localhost:8080

# Claves PÚBLICAS del SDK de RevenueCat (dashboard → Project settings → API keys
# → "Public app-specific API keys"). A diferencia de GEMINI_API_KEY, estas SÍ
# están pensadas para ir dentro de la app — no dan acceso a nada sensible por sí
# solas, solo identifican tu proyecto ante RevenueCat. Vacías = "Suscribirme"
# usa la simulación local en vez de abrir la compra real de App Store/Google Play.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
